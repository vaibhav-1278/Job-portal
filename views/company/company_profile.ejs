<%- include('navbar.ejs') %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Company Profile | <%= company.company_name %></title>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <!-- Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <style>
    :root {
      --primary: #2c3e50;
      --secondary: #2c3e50;
      --accent: #e67e22;
      --light: #f8f9fa;
      --dark: #2c3e50;
      --gray: #6c757d;
      --success: #28a745;
      --warning: #ffc107;
      --danger: #dc3545;
      --border-radius: 12px;
      --box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
      --transition: all 0.3s ease;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #f5f7fa 0%, #e4edf5 100%);
      color: #333;
      line-height: 1.6;
      min-height: 100vh;
      padding: 20px 15px;
      margin-top: 30px!important;
    }

    .profile-container {
      max-width: 1200px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: var(--border-radius);
      box-shadow: var(--box-shadow);
      overflow: hidden;
            margin-top: 30px!important;

      animation: fadeInUp 0.8s ease-out;
    }

    /* Header Section */
    .profile-header {
      background: linear-gradient(135deg, var(--primary) 0%, #34495e 100%);
      color: #fff;
      padding: 50px 40px;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      justify-content: space-between;
      position: relative;
      border-bottom: 4px solid var(--accent);
    }

    .company-details {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 30px;
    }

    .company-logo-container {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .company-logo {
      width: 160px;
      height: 160px;
      border-radius: 50%;
      border: 4px solid rgba(255, 255, 255, 0.2);
      object-fit: cover;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
      transition: var(--transition);
      background-color: #fff;
      padding: 5px;
    }

    .company-logo:hover {
      transform: scale(1.05);
      border-color: var(--accent);
    }

    .company-info h2 {
      font-size: 32px;
      font-weight: 700;
      margin-bottom: 10px;
      letter-spacing: -0.5px;
    }

    .company-info p {
      font-size: 16px;
      margin: 5px 0;
      color: rgba(255, 255, 255, 0.85);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .company-info i {
      color: var(--accent);
      width: 20px;
    }

    .action-buttons {
      display: flex;
      gap: 15px;
      margin-top: 20px;
    }

    .btn-edit {
      background: var(--accent);
      color: #fff;
      border: none;
      padding: 12px 28px;
      border-radius: 8px;
      font-weight: 600;
      transition: var(--transition);
      box-shadow: 0 4px 12px rgba(230, 126, 34, 0.3);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .btn-edit:hover {
      background: #d35400;
      color: #fff;
      transform: translateY(-3px);
      box-shadow: 0 6px 15px rgba(230, 126, 34, 0.4);
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.3);
      padding: 12px 28px;
      border-radius: 8px;
      font-weight: 600;
      transition: var(--transition);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.25);
      color: #fff;
      transform: translateY(-3px);
    }

    /* Details Section */
    .profile-details {
      padding: 50px 40px;
    }

    .section-title {
      font-weight: 700;
      font-size: 24px;
      color: var(--primary);
      margin-bottom: 35px;
      position: relative;
      padding-bottom: 12px;
    }

    .section-title:after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 60px;
      height: 4px;
      background: var(--accent);
      border-radius: 2px;
    }

    .details-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 25px;
    }

    .detail-item {
      background: #fff;
      border-radius: 10px;
      padding: 25px;
      border: 1px solid #eaeaea;
      transition: var(--transition);
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.04);
      position: relative;
      overflow: hidden;
    }

    .detail-item:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
      border-color: #e0e0e0;
    }

    .detail-item:before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: var(--secondary);
      opacity: 0;
      transition: var(--transition);
    }

    .detail-item:hover:before {
      opacity: 1;
    }

    .detail-item strong {
      display: block;
      color: var(--primary);
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 10px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      opacity: 0.8;
    }

    .detail-item span {
      color: var(--dark);
      font-size: 16px;
      font-weight: 500;
      word-break: break-word;
      overflow-wrap: anywhere;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 14px;
      font-weight: 500;
    }

    .status-active {
      background: rgba(40, 167, 69, 0.1);
      color: var(--success);
    }

    .status-pending {
      background: rgba(255, 193, 7, 0.1);
      color: var(--warning);
    }

    .status-inactive {
      background: rgba(220, 53, 69, 0.1);
      color: var(--danger);
    }

    .verified-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 14px;
      font-weight: 500;
      background: rgba(52, 152, 219, 0.1);
      color: var(--secondary);
    }

    /* Stats Section */
    .stats-section {
      padding: 40px;
      background: #f8f9fa;
      border-top: 1px solid #eaeaea;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
    }

    .stat-card {
      background: #fff;
      border-radius: 10px;
      padding: 25px;
      text-align: center;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.04);
      transition: var(--transition);
    }

    .stat-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    }

    .stat-value {
      font-size: 32px;
      font-weight: 700;
      color: var(--primary);
      margin-bottom: 5px;
    }

    .stat-label {
      font-size: 14px;
      color: var(--gray);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* Animations */
    @keyframes fadeInUp {
      0% { opacity: 0; transform: translateY(30px); }
      100% { opacity: 1; transform: translateY(0); }
    }

    /* Responsive */
    @media (max-width: 992px) {
      .profile-header {
        padding: 40px 30px;
      }
      .profile-details {
        padding: 40px 30px;
      }
      .stats-section {
        padding: 30px;
      }
    }

    @media (max-width: 768px) {
      .profile-header {
        text-align: center;
        padding: 35px 25px;
        flex-direction: column;
      }
      .company-details {
        justify-content: center;
        text-align: center;
      }
      .action-buttons {
        justify-content: center;
        flex-wrap: wrap;
      }
      .profile-details {
        padding: 30px 25px;
      }
      .details-grid {
        grid-template-columns: 1fr;
      }
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 576px) {
      .stats-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>

  <div class="profile-container">
    <!-- HEADER -->
    <div class="profile-header">
      <div class="company-details">
        <div class="company-logo-container">
          <img src="/company_logo/<%= company.company_logo ? company.company_logo : 'default.jpg' %>"  
               alt="<%= company.company_name %> Logo" 
               class="company-logo" 
               id="company_logo">
        </div>
        <div class="company-info">
          <h2 id="company_name"><%= company.company_name %></h2>
          <p><i class="fas fa-building"></i> <span id="company_type"><%= company.company_type %></span></p>
          <p><i class="fas fa-industry"></i> <span id="industry"><%= company.industry %></span></p>
          <p><i class="fas fa-map-marker-alt"></i> <span id="company_location"><%= company.company_location %></span></p>
          
          <div class="action-buttons">
            <a href="/company/edit_company_profile" class="btn-edit">
              <i class="fas fa-edit"></i> Edit Profile
            </a>
            <button class="btn-secondary">
              <i class="fas fa-share-alt"></i> Share Profile
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- DETAILS -->
    <div class="profile-details">
      <h4 class="section-title">Company & HR Details</h4>
      <div class="details-grid">
        <div class="detail-item">
          <strong>HR Name</strong>
          <span id="hr_name"><%= company.hr_name %></span>
        </div>
        <div class="detail-item">
          <strong>HR Designation</strong>
          <span id="hr_designation"><%= company.hr_designation %></span>
        </div>
        <div class="detail-item">
          <strong>HR Mobile</strong>
          <span id="hr_mobile"><i class="fas fa-phone"></i> <%= company.hr_mobile %></span>
        </div>
        <div class="detail-item">
          <strong>Company Email</strong>
          <span id="company_email"><i class="fas fa-envelope"></i> <%= company.company_email %></span>
        </div>
        <div class="detail-item">
          <strong>Website URL</strong>
          <span id="website_url"><i class="fas fa-globe"></i> 
            <% if (company.website_url && company.website_url !== '') { %>
              <a href="<%= company.website_url %>" target="_blank"><%= company.website_url %></a>
            <% } else { %>
              Not provided
            <% } %>
          </span>
        </div>
        <div class="detail-item">
          <strong>Status</strong>
          <span id="status">
    <span class="status-badge status-active">
      <% if (company.is_verified == 1) { %>
      <i class="fas fa-check-circle"></i> <%= company.status %>
      <% } else if (company.is_verified !=1 ) { %>
      <i class="fas fa-times-circle"></i>Deconfirmed
      <% } %>
    </span>
 
</span>

        </div>
  <div class="detail-item">
  <strong>Verification Status:</strong>
  <span id="is_verified">
    <% if (company.is_verified == 1) { %>
      <span class="verified-badge">
        <i class="fas fa-shield-alt"></i> Verified
      </span>
      <form action="/company/toggle_verify/<%= company.company_id %>" method="POST" class="d-inline">
        <button class="btn btn-danger btn-sm ms-2">Unverify</button>
      </form>
    <% } else { %>
      <span class="status-badge status-pending">
        <i class="fas fa-clock"></i> Pending Verification
      </span>
      <form action="/company/toggle_verify/<%= company.company_id %>" method="POST" class="d-inline">
        <button class="btn btn-success btn-sm ms-2">Verify</button>
      </form>
    <% } %>
  </span>
</div>


        <div class="detail-item">
          <strong>Member Since</strong>
          <span id="created_at"><i class="fas fa-calendar-alt"></i> <%= new Date(company.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
        </div>
        <div class="detail-item">
          <strong>Last Updated</strong>
          <span id="updated_at"><i class="fas fa-calendar-check"></i> <%= new Date(company.updated_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
        </div>
      </div>
    </div>

    <!-- STATS SECTION (Optional - can be populated with real data) -->
    <div class="stats-section">
      <h4 class="section-title">Company Statistics</h4>
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-value">24</div>
          <div class="stat-label">Active Jobs</div>
        </div>
        <div class="stat-card">
          <div class="stat-value">156</div>
          <div class="stat-label">Applications</div>
        </div>
        <div class="stat-card">
          <div class="stat-value">89%</div>
          <div class="stat-label">Response Rate</div>
        </div>
        <div class="stat-card">
          <div class="stat-value">4.8</div>
          <div class="stat-label">Company Rating</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  
  <script>
    // Add some interactive functionality
    document.addEventListener('DOMContentLoaded', function() {
      // Add animation to stat cards on scroll
      const statCards = document.querySelectorAll('.stat-card');
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.style.animation = 'fadeInUp 0.6s ease-out forwards';
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      
      statCards.forEach(card => {
        card.style.opacity = '0';
        observer.observe(card);
      });
      
      // Share button functionality
      const shareButton = document.querySelector('.btn-secondary');
      if (shareButton) {
        shareButton.addEventListener('click', function() {
          if (navigator.share) {
            navigator.share({
              title: '<%= company.company_name %>',
              text: 'Check out this company profile',
              url: window.location.href,
            })
            .catch(err => console.log('Error sharing:', err));
          } else {
            // Fallback for browsers that don't support Web Share API
            navigator.clipboard.writeText(window.location.href)
              .then(() => {
                const originalText = shareButton.innerHTML;
                shareButton.innerHTML = '<i class="fas fa-check"></i> Copied!';
                setTimeout(() => {
                  shareButton.innerHTML = originalText;
                }, 2000);
              })
              .catch(err => console.log('Error copying to clipboard:', err));
          }
        });
      }
    });
  </script>
</body>
</html>
<%- include('footer.ejs') %>