<script>
  // Load staff profile dynamically
  $.ajax({
    url: '/profile_data',
    dataType: 'json'
  }).done(function(data) {
    $('#staffName').text(data.staff.staff_name);
    $('#staffPhoto').attr('src', '/images/' + data.staff.staff_photo);
  });
</script>

