<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Job Hyre</title>
  <style>
.heading-gradient {
  font-weight: 700;
  color: #2c3e50;
}

.shiny-card {
  background: #ffffff;
  border-radius: 12px;
  padding: 25px;
  border: 1px solid #e1e4e8;
  box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  transition: 0.2s ease-in-out;
}

.shiny-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 22px rgba(0,0,0,0.08);
}

.table thead th {
  background: #f8f9fb;
  color: #2c3e50;
  font-weight: 600;
  border-bottom: 2px solid #e1e4e8;
  padding: 12px 15px;
}

.table-striped > tbody > tr:nth-of-type(odd) {
  background-color: #fafafa;
}

.table-hover tbody tr:hover {
  background-color: #eef7ff;
}

.job-type-badge {
  padding: 0.35em 0.7em;
  font-size: 0.85rem;
  color: #fff;
  border-radius: 8px;
  background: #3498db;
}

.btn-sm.rounded-circle {
  width: 32px;
  height: 32px;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-warning {
  background-color: #f7c948;
  border: none;
}

.btn-danger {
  background-color: #e74c3c;
  border: none;
}

h2.display-5 {
  color: #2c3e50;
}
.container{
  margin-top: 8%;
}
@media (max-width: 768px) {
  .table-responsive {
    overflow-x: auto;
  }
    .container
  {
    margin-top: 20%;
  }
}
</style>
</head>
<body>
  <%- include('navbar.ejs') %>

<div class="container">
  <div class="text-center mb-4">
    <p class="text-muted fs-5 fw-bold text-dark "><i class="fas fa-briefcase me-2"></i>Manage all the jobs you have posted efficiently</p>
  </div>

  <div class="table-responsive shadow-lg rounded p-3 bg-white shiny-card">
    <table class="table table-bordered align-middle table-striped table-hover text-center">
      <thead>
        <tr>
           <th>Actions</th>
          <th>Sr No</th>
          <th>Job Title</th>
          <th>Job Description</th>
          <th>Job Type</th>
          <th>Experience</th>
          <th>Skills</th>
          <th>Vacancies</th>
          <th>Salary Range</th>
          <th>Application Deadline</th>
          <th>Application</th>
        </tr>
      </thead>
      <tbody>
        <% for (let i = 0; i < jobs.length; i++) { %>
          <tr>
             <td>
              <a href="/company/edit_post_jobs/<%- jobs[i].job_id %>" class="btn btn-sm btn-warning rounded-circle me-1" data-bs-toggle="tooltip" title="Edit Job">
                <i class="fas fa-edit"></i>
              </a>
              <a href="/company/delete_post_jobs/<%- jobs[i].job_id %>" class="btn btn-sm btn-danger rounded-circle " onclick="return confirm('Are you sure you want to delete this job?');" data-bs-toggle="tooltip" title="Delete Job">
                <i class="fas fa-trash"></i>
              </a>
            </td>
            <td><%- i + 1 %></td>
            <td class="fw-bold text-start"><%- jobs[i].job_title %></td>
            <td class="text-start"><%- jobs[i].job_description %></td>
            <td>
              <span class="badge job-type-badge"><%- jobs[i].job_type %></span>
            </td>
            <td><%- jobs[i].experience_min %> - <%- jobs[i].experience_max %> yrs</td>
            <td class="text-start"><%- jobs[i].skills %></td>
            <td><%- jobs[i].vacancies %></td>
          <td>
              <% if (jobs[i].salary_range && jobs[i].salary_range !== '0') { %>
              ₹ <%= jobs[i].salary_range %> 
              <% } else { %>
            Unpaid         
             <% } %>
</td>

            <!-- <td>₹ <%- jobs[i].salary_range %></td> -->
            <td><%- new Date(jobs[i].application_deadline).toLocaleDateString() %></td>
           
           <td>
            <a href="/company/applications/<%-jobs[i].job_id%>" class="btn btn-primary"><%-jobs[i].application_count%> Candidates</a>
           </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('footer.ejs') %>




<script>
const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
const tooltipList = [...tooltipTriggerList].map(el => new bootstrap.Tooltip(el));
</script>

</body>
</html>