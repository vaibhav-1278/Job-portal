          <!-- Quick Actions Section -->
          <div class="quick-actions">
            <p class="fw-bold text-primary mb-3">Quick Actions</p>
            <div class="d-grid gap-2">
             <form id="resumeForm" action="/employees/update_employee_resume" method="POST" enctype="multipart/form-data">
  <input type="file" id="resumeInput" name="resume_file" accept=".pdf,.doc,.docx" style="display: none;">
  
  <button type="button" class="btn btn-outline-primary w-100" id="uploadBtn">
    <i class="bi bi-upload me-2"></i> Update Resume
  </button>
</form>

<script>
  // When the button is clicked, open the hidden file input
  document.getElementById('uploadBtn').addEventListener('click', function() {
    document.getElementById('resumeInput').click();
  });

  // When file is selected, automatically submit the form
  document.getElementById('resumeInput').addEventListener('change', function() {
    if (this.files.length > 0) {
      document.getElementById('resumeForm').submit();
    }
  });
</script>

              <a href="/employees/view_saved_jobs">
                <button class="btn btn-outline-success w-100">
                  <i class="bi bi-bookmark-heart me-2"></i> Saved Jobs
                </button>
              </a>

               <!-- Download Resume Button -->
          
              <a href="/employee_resume/<%= employee.employee_resume %>" class="btn btn-outline-success" download>
                <i class="bi bi-download"></i> Download Resume
              </a>

            </div>
          </div>
        </div>
      </div>

      <!-- Right Job Recommendations -->
      <div class="col-md-8">
        <h5 class="fw-bold mb-3 mt-5 text-primary">Recommended For You</h5>
`
        <!-- Scrollable Job List -->
        <div class="job-list-container">
          <% for(var i = 0; i < recent_jobs.length; i++) { %>
            <div class="job-card fade-in">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <h5><%- recent_jobs[i].job_title %></h5>
                <span class="badge bg-success"><%- recent_jobs[i].status %></span>
              </div>
              <p class="mb-1 text-muted text-primary  " ><%- recent_jobs[i].company_name %></p>
              <ul class="list-inline small text-muted mb-2">
                <li class="list-inline-item">
                  <i class="bi bi-geo-alt"></i> <%- recent_jobs[i].location %>
                </li>
                <li class="list-inline-item">
                  <i class="bi bi-briefcase"></i> <%- recent_jobs[i].job_type %>
                </li>
                <li class="list-inline-item">
                  <i class="bi bi-currency-dollar"></i> <%- recent_jobs[i].salary_range %>
                </li>
                <li class="list-inline-item">
                  <i class="bi bi-code-slash"></i> <%- recent_jobs[i].skills %>
                </li>
                <li class="list-inline-item">
                  Created: <%- new Date(recent_jobs[i].created_at).toLocaleDateString() %>
                </li>
              </ul>
              <p class="text-muted">
                <%- recent_jobs[i].job_description %>
              </p>
             <div class="d-flex justify-content-end gap-2">
 <% if (recent_jobs[i].saved_jobs_count > 0) { %>
  <!-- Job already saved -->
  <button disabled class="btn btn-secondary btn-sm">Saved</button>
<% } else { %>
  <!-- Job not saved yet -->
  <a href="/employees/save_job/<%- recent_jobs[i].job_id %>">
    <button class="btn btn-outline-secondary btn-sm">Save</button>
  </a>
<% } %>


  <% if (recent_jobs[i].application_count > 0) { %>
    <!-- Job already applied -->
    <button disabled class="btn btn-secondary btn-sm btn-apply">Applied</button>
  <% } else { %>
    <!-- Job not applied yet -->
    <button onclick="apply_job('<%- recent_jobs[i].job_id %>')" class="btn btn-primary btn-sm btn-apply">Apply Now</button>
  <% } %>
</div>

            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>


<!-- Apply Job Modal -->
<div class="modal fade" id="applyModal" tabindex="-1" aria-labelledby="applyModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content p-3 rounded-4 shadow">
      
      <!-- Modal Header -->
      <div class="modal-header border-0">
        <h5 class="modal-title fw-bold text-primary" id="applyModalLabel">Apply for Job</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Modal Form -->
      <form action="/employees/apply_job" method="POST" enctype="multipart/form-data">
        <div class="modal-body">
          <input type="hidden" name="job_id" id="modalJobId">

          <div class="mb-3">
            <label for="applicantName" class="form-label fw-semibold">Enter Your Name</label>
            <input type="text" class="form-control" id="applicantName" name="applicant_name" required>
          </div>

          <div class="mb-3">
            <label for="applicantEmail" class="form-label fw-semibold">Enter Your Email</label>
            <input type="email" class="form-control" id="applicantEmail" name="applicant_email" required>
          </div>

          <div class="mb-3">
            <label for="resumeFile" class="form-label fw-semibold">Upload Resume</label>
            <input type="file" class="form-control" id="resumeFile" name="applicant_resume_file" accept=".pdf,.doc,.docx" required>
            <small class="text-muted">Accepted formats: .pdf, .doc, .docx</small>
          </div>
        </div>

        <!-- Modal Footer -->
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Submit Application</button>
        </div>
      </form>
    </div>
  </div>
</div>


 <!-- jQuery CDN -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
  function apply_job(job_id) {
    // Open modal properly using correct selector
    $('#applyModal').modal('show');

    // Set job ID in hidden input (optional but useful)
    $('#modalJobId').val(job_id);
  }
</script>
  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</body>
</html>
