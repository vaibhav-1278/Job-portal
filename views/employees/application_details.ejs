<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= application.job_title %> | Job Details</title>

  <!-- Bootstrap + Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

  <style>
    body {
      background-color: #f5f7fb;
      font-family: 'Poppins', sans-serif;
      color: #2c3e50;
      overflow-x: hidden;
    }

    .job-card {
      max-width: 1050px;
      margin: 60px auto;
      background: #fff;
      padding: 40px 45px;
      border-radius: 18px;
      border: 1px solid #e8eaef;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
      transition: 0.3s ease;
    }

    .job-card:hover {
      box-shadow: 0 14px 35px rgba(0, 0, 0, 0.12);
    }

    .job-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #eee;
      padding-bottom: 25px;
      flex-wrap: wrap;
      gap: 20px;
    }

    .company-info {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .company-logo {
      width: 90px;
      height: 90px;
      object-fit: cover;
      border-radius: 14px;
      border: 1px solid #dcdcdc;
      background: #fafafa;
    }

    .job-title {
      font-size: 1.9rem;
      font-weight: 700;
      color: #1c1f26;
    }

    .company-name {
      font-size: 1rem;
      font-weight: 600;
      color: #0d6efd;
    }

    .location-text {
      font-size: 0.9rem;
      color: #6c757d;
    }

    .status-badge {
      background: #e9f7ef;
      padding: 0.45rem 1rem;
      color: #198754;
      border-radius: 25px;
      font-weight: 600;
      font-size: 0.85rem;
    }

    .section-title {
      margin-top: 35px;
      font-size: 1.25rem;
      font-weight: 600;
      color: #343a40;
      border-left: 4px solid #0d6efd;
      padding-left: 10px;
    }

    .desc-box {
      background: #f8f9fa;
      padding: 18px;
      border-radius: 10px;
      border: 1px solid #ececec;
      line-height: 1.7;
      color: #555;
      margin-top: 12px;
    }

    .info-grid {
      margin-top: 18px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 15px;
    }

    .info-item {
      background: #fff;
      padding: 14px 18px;
      border-radius: 10px;
      border: 1px solid #e8eaef;
      display: flex;
      align-items: center;
      gap: 12px;
      transition: 0.3s ease;
    }

    .info-item:hover {
      background: #f1f3f5;
    }

    .info-icon {
      color: #0d6efd;
      font-size: 1.4rem;
    }

    .skills-container {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 18px;
    }

    .skill-tag {
      padding: 7px 16px;
      background: #e7f1ff;
      border-radius: 20px;
      font-weight: 500;
      color: #0d6efd;
      font-size: 0.9rem;
      white-space: nowrap;
      border: 1px solid #d0e3ff;
    }

    .company-info-card {
      margin-top: 18px;
      background: #f8f9fa;
      border: 1px solid #e8eaef;
      padding: 18px;
      border-radius: 10px;
    }

    .action-buttons {
      margin-top: 32px;
      display: flex;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    .btn-back {
      padding: 10px 25px;
      font-weight: 600;
      border-radius: 30px;
      background: #dde2e6;
      color: #000;
    }

    .btn-back:hover {
      background: #cfd4da;
    }

    @media (max-width: 768px) {
      .job-card {
        padding: 25px;
        margin: 20px 15px;
      }

      .company-info {
        flex-direction: column;
        align-items: flex-start;
      }

      .action-buttons {
        display: grid;
        margin-left: 30%;
        gap: 10px;
        width: 30% !important;
      }
    }

    @media (max-width: 576px) {
      .job-title {
        font-size: 1.5rem;
      }

      .job-card {
        margin-top: 15% !important;
        padding: 18px;
      }
    }
  </style>
</head>

<body>

  <!-- Navbar -->
  <%- include('navbar.ejs') %>

  <div class="job-card">

    <div class="job-header">
      <div class="company-info">
        <img src="/company_logo/<%= application.company_logo %>" class="company-logo"
          onerror="this.src='https:via.placeholder.com/90?text=Logo'">

        <div>
          <h2 class="job-title"><%= application.job_title %></h2>
          <div class="company-name"><%= application.company_name %></div>
          <div class="location-text"><i class="bi bi-geo-alt"></i> <%= application.company_location || "Not specified" %></div>
        </div>
      </div>

      <span class="status-badge">
        <i class="bi bi-<%= application.status === 'active' ? 'check-circle' : 'clock' %> me-1"></i>
        <%= application.status.charAt(0).toUpperCase() + application.status.slice(1) %>
      </span>
    </div>

    <div class="section-title">Job Description</div>
    <div class="desc-box"><%= application.job_description %></div>

    <div class="section-title">Application Information</div>
    <div class="info-grid">

      <div class="info-item">
        <i class="bi bi-briefcase info-icon"></i>
        <strong>Type:</strong>&nbsp;<%= application.job_type %>
      </div>

      <div class="info-item">
        <i class="bi bi-graph-up info-icon"></i>
        <strong>Experience:</strong>&nbsp;<%= application.experience_min %> - <%= application.experience_max %> years
      </div>

      <div class="info-item">
        <i class="bi bi-people info-icon"></i>
        <strong>Vacancies:</strong>&nbsp;<%= application.vacancies %>
      </div>

      <% if (application.salary_range) { %>
      <div class="info-item">
        <i class="bi bi-currency-dollar info-icon"></i>
        <strong>Salary:</strong>&nbsp;<%= application.salary_range %>
      </div>
      <% } %>

      <% if (application.application_deadline) { %>
      <div class="info-item">
        <i class="bi bi-calendar-check info-icon"></i>
        <strong>Deadline:</strong>&nbsp;<%= new Date(application.application_deadline).toLocaleDateString() %>
      </div>
      <% } %>

    </div>

    <div class="section-title">Required Skills</div>
    <div class="skills-container">
      <% if (application.skills) { application.skills.split(' ').forEach(skill => { %>
      <span class="skill-tag"><%= skill %></span>
      <% }) } else { %>
      <span class="skill-tag">No skills mentioned</span>
      <% } %>
    </div>

    <div class="section-title">Company Information</div>
    <div class="company-info-card">
      <p><strong>Type:</strong> <%= application.company_type %></p>
      <p><strong>Industry:</strong> <%= application.industry %></p>

      <% if (application.website_url) { %>
      <p><strong>Website:</strong> <a href="<%= application.website_url %>" target="_blank"><%= application.website_url %></a></p>
      <% } %>
    </div>

    <div class="action-buttons">
      <a href="/employees/my_applications" class="btn btn-back btn-secondary">
        ← Back
      </a>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <%- include('footer.ejs') %>

</body>

</html>
