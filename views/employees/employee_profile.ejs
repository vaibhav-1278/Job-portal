<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Professional Employee Profile</title>


  <!-- Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <!-- Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #eef2f3 0%, #d9e4ec 100%);
      color: #2c3e50;
      padding: 30px 15px;
    }

    .profile-container {
      margin-top: 3% !important;
      max-width: 1200px;
      margin: auto;
    }

    .profile-header {
      background: #fff;
      border-radius: 15px;
      box-shadow: 0 4px 25px rgba(0, 0, 0, 0.1);
      padding: 25px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      margin-bottom: 25px;
    }

    .profile-photo {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      border: 4px solid #007bff;
      object-fit: cover;
      box-shadow: 0 4px 15px rgba(0, 123, 255, 0.3);
    }

    .edit-btn {
      background: linear-gradient(135deg, #007BFF, #0056b3);
      color: #fff;
      border: none;
      border-radius: 25px;
      padding: 8px 18px;
      font-weight: 600;
      transition: 0.3s;
    }

    .edit-btn:hover {
      box-shadow: 0 5px 15px rgba(0, 123, 255, 0.4);
      transform: translateY(-2px);
    }

    .profile-card {
      background: #fff;
      border-radius: 15px;
      box-shadow: 0 4px 25px rgba(0, 0, 0, 0.1);
      padding: 25px;
      margin-bottom: 25px;
    }

    .section-title {
      font-weight: 600;
      color: #007bff;
      margin-bottom: 15px;
      border-bottom: 2px solid rgba(0, 123, 255, 0.2);
      padding-bottom: 5px;
    }

    .detail-item {
      display: flex;
      justify-content: space-between;
      border-bottom: 1px solid #f0f0f0;
      padding: 6px 0;
      font-size: 15px;
    }

    .detail-item:last-child {
      border-bottom: none;
    }

    .detail-label {
      color: #6c757d;
    }

    .detail-value {
      font-weight: 600;
      color: #2c3e50;
    }

    .badge-skill {
      background: linear-gradient(135deg, #007bff, #00b09b);
      color: #fff;
      border-radius: 20px;
      padding: 5px 12px;
      margin: 2px;
      font-size: 13px;
    }

    .verification-badge {
      background: #28a745;
      color: white;
      padding: 4px 10px;
      border-radius: 15px;
      font-weight: 600;
      font-size: 14px;
    }

    .progress {
      height: 10px;
      border-radius: 5px;
      overflow: hidden;
    }

    @media (max-width:768px) {
      .profile-header {
        flex-direction: column;
        text-align: center;
      }
    }

    .profile-container {
      margin-top: 3 % !important;
    }
  </style>
</head>

<body>
  <%-include('navbar.ejs')%>

    <div class="profile-container mt-5">

      <!-- HEADER -->
      <div class="profile-header">
        <div class="d-flex align-items-center gap-3">
          <img src="/employee_photo/<%= employee.employee_profile_photo %>" class="profile-photo" alt="Profile Photo"
            id="employee_profile_photo">
          <div>
            <h3 class="fw-bold mb-0" id="employee_name"><%-employee.employee_name%></h3>
            <p class="mb-1 text-muted"><span
                id="employee_current_designation"><%-(employee.employee_current_designation) ?
                  employee.employee_current_designation : 'N/A ' %></span></p>
            <span class="verification-badge" id="is_verified">Verified</span>
          </div>
        </div>
        <div>
          <a href="/employees" class="btn edit-btn">
            <i class="bi bi-arrow-left"></i> Home
          </a>
          <a href="/employees/edit_employee_profile"><button class="edit-btn"><i class="bi bi-pencil"></i> Edit
              Profile</button></a>
        </div>
        <div class="w-100 mt-3">
          <div class="d-flex justify-content-between mb-1">
            <small>Profile Completion</small>
            <small id="profile_complete">
              <%= profile_complete %>%
            </small>
          </div>
          <div class="progress">
            <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar"
              style="width: <%= profile_complete %>%;" aria-valuenow="<%= profile_complete %>" aria-valuemin="0"
              aria-valuemax="100">
            </div>
          </div>
          <!-- ✅ PROFILE COMPLETED MESSAGE -->
        <% if(profile_complete == 100){ %>
          <div class="alert alert-success mt-3 text-center fw-semibold">
            <i class="bi bi-check-circle-fill"></i>
            Profile Completed Successfully 🎉
          </div>
        <% } %>

      </div>
    </div>
        </div>
      </div>

   

      <div class="row g-4">
        <!-- LEFT COLUMN -->
        <div class="col-md-4">
          <div class="profile-card">
            <h6 class="section-title">Personal Information</h6>
            <div class="detail-item"><span class="detail-label">Mobile</span><span class="detail-value"
                id="employee_mobile"><%-employee.employee_mobile%></span></div>
            <div class="detail-item"><span class="detail-label">Alternate Mobile</span><span
                class="detail-value"><%-(employee.employee_alternate_mobile) ? employee.employee_alternate_mobile
                  : 'N/A ' %></span></div>
            <div class="detail-item"><span class="detail-label">Email</span><span
                class="detail-value"><%-(employee.employee_email) ? employee.employee_email : 'N/A ' %></span></div>
            <div class="detail-item"><span class="detail-label">Date of Birth</span><span
                class="detail-value"><%-(employee.employee_dob) ? employee.employee_dob : 'N/A ' %></span></div>
            <div class="detail-item"><span class="detail-label">Gender</span><span
                class="detail-value"><%-(employee.employee_gender) ? employee.employee_gender : 'N/A ' %></span></div>
            <div class="detail-item"><span class="detail-label">Marital Status</span><span
                class="detail-value"><%-(employee.employee_marital_status) ? employee.employee_marital_status : 'N/A '
                  %></span></div>
            <div class="detail-item"><span class="detail-label">Address</span><span
                class="detail-value"><%-(employee.employee_address) ? employee.employee_address : 'N/A ' %></span></div>
            <div class="detail-item"><span class="detail-label">Pincode</span><span
                class="detail-value"><%-(employee.employee_pincode) ? employee.employee_pincode : 'N/A ' %></span></div>
          </div>

          <div class="profile-card">
            <h6 class="section-title">Professional Summary</h6>
            <div class="detail-item"><span class="detail-label">Current Designation</span><span class="detail-value">
                <%= employee.employee_current_designation ? employee.employee_current_designation : 'N/A' %>
              </span></div>
            <div class="detail-item"><span class="detail-label">Experience</span><span class="detail-value">
                <%= employee.employee_experience_years ? employee.employee_experience_years : 'N/A' %>yr
              </span></div>
            <div class="detail-item"><span class="detail-label">Current Salary</span><span class="detail-value">₹<%=
                  employee.employee_current_salary ? employee.employee_current_salary : 'N/A' %></span></div>
            <div class="detail-item"><span class="detail-label">Expected Salary</span><span class="detail-value">₹<%=
                  employee.employee_expected_salary ? employee.employee_expected_salary : 'N/A' %></span></div>
            <div class="detail-item"><span class="detail-label">Preferred Job Type</span><span class="detail-value">
                <%= employee.employee_preferred_job_type ? employee.employee_preferred_job_type : 'N/A' %>
              </span></div>
            <div class="detail-item"><span class="detail-label">Preferred Locations</span><span class="detail-value">📍
                <%= employee.employee_preferred_locations ? employee.employee_preferred_locations : 'N/A' %>
              </span>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="col-md-8">
          <div class="profile-card">
            <h6 class="section-title">Skills & Languages</h6>
            <div class="detail-item"><span class="detail-label text-dark">Skills</span>
              <div class="detail-value">
                <span class="badge-skill"><%-(employee.employee_skills_summary) ? employee.employee_skills_summary
                    : 'N/A ' %></span>
              </div>
            </div>
            <div class="detail-item"><span class="detail-label text-dark">Languages Known</span>
              <div class="detail-value">
                <span class="badge-skill"><%-(employee.employee_languages_known) ? employee.employee_languages_known
                    : 'N/A ' %></span>
              </div>
            </div>
          </div>

          <div class="profile-card">
            <h6 class="section-title">Education</h6>
            <div class="table-responsive">
              <table class="table table-bordered align-middle">
                <thead class="table-light">
                  <tr>
                  <th><a href="/employees/edit_employee_profile">
                      <button class="btn btn-sm btn-primary">Add</button>
                    </a></th> 
                    <th>College Name</th>
                    <th>Course Title</th>
                    <th>Passing Year</th>
                    <th>Marks</th>
                    <th>Status</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% for(var i=0; i < employee_educations.length; i++){ %>
                    <tr>
                      <td></td>
                      <td>
                        <%= employee_educations[i].college_name ? employee_educations[i].college_name : 'N/A' %>
                      </td>
                      <td>
                        <%= employee_educations[i].course_title ? employee_educations[i].course_title : 'N/A' %>
                      </td>
                      <td>
                        <%= employee_educations[i].passing_year ? employee_educations[i].passing_year : 'N/A' %>
                      </td>
                      <td>
                        <%= employee_educations[i].marks ? employee_educations[i].marks : 'N/A' %>
                      </td>
                      <td>
                        <%= employee_educations[i].status ? employee_educations[i].status : 'N/A' %>
                      </td>
                      <td>
                        <a href="/employees/edit_education/<%-employee_educations[i].education_id%>"><i
                            class="bi bi-pencil-square"></i></a>
                        &nbsp;&nbsp;&nbsp;&nbsp;
                        <a href="/employees/delete_education/<%-employee_educations[i].education_id%>"><i
                            class="bi bi-trash"></i></a>
                      </td>
                    </tr>
                    <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="profile-card">
            <h6 class="section-title">Documents & Links</h6>

            <!-- Resume -->
            <div class="detail-item">
              <span class="detail-label text-dark">Resume</span>
              <% if(employee.employee_resume && employee.employee_resume.trim() !=="" ) { %>
                <a href="/<%= employee.employee_resume %>" class="detail-value" target="_blank">View Resume</a>
                <% } else { %>
                  <span class="detail-value">N/A</span>
                  <% } %>
            </div>

            <!-- LinkedIn -->
            <div class="detail-item">
              <span class="detail-label text-dark">LinkedIn</span>
              <% if(employee.employee_linkedin_url && employee.employee_linkedin_url.trim() !=="" ) { %>
                <a href="<%= employee.employee_linkedin_url %>" class="detail-value" target="_blank">
                  <%= employee.employee_linkedin_url %>
                </a>
                <% } else { %>
                  <span class="detail-value">N/A</span>
                  <% } %>
            </div>

            <!-- GitHub -->
            <div class="detail-item">
              <span class="detail-label text-dark">GitHub</span>
              <% if(employee.employee_github_url && employee.employee_github_url.trim() !=="" ) { %>
                <a href="<%= employee.employee_github_url %>" class="detail-value" target="_blank">
                  <%= employee.employee_github_url %>
                </a>
                <% } else { %>
                  <span class="detail-value">N/A</span>
                  <% } %>
            </div>

            <!-- Portfolio -->
            <div class="detail-item">
              <span class="detail-label text-dark">Portfolio</span>
              <% if(employee.employee_portfolio_url && employee.employee_portfolio_url.trim() !=="" ) { %>
                <a href="<%= employee.employee_portfolio_url %>" class="detail-value" target="_blank">
                  <%= employee.employee_portfolio_url %>
                </a>
                <% } else { %>
                  <span class="detail-value">N/A</span>
                  <% } %>
            </div>

            <!-- Download Resume Button -->
            <div class="text-end mt-3">
              <a href="/employee_resume/<%= employee.employee_resume %>" class="btn btn-success" download>
                <i class="bi bi-download"></i> Download Resume
              </a>
            </div>

          </div>

          <!-- <div class="text-end text-muted small mt-4">
            <p>
              Created At: <span id="created_at">
                <%= new Date(employee.created_at).toLocaleString() %>
              </span> |
              Updated At: <span id="updated_at">
                <%= new Date(employee.updated_at).toLocaleString() %>
              </span>
            </p>
          </div> -->

        </div>
      </div>
    </div>
    <%-include('footer.ejs')%>

      <!-- Bootstrap JS -->
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>