<%-include('navbar.ejs')%> 
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Education</title>
  <!-- Bootstrap 5 CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    body {
      background-color: #f5f6fa;
      font-family: 'Poppins', sans-serif;
    }
    .form-card {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      padding: 30px;
      max-width: 900px;
      margin-top: 10%!important;
      margin: 50px auto;
      border: 1px solid #e0e0e0;
      transition: 0.3s;
    }
    .form-card:hover {
      box-shadow: 0 6px 16px rgba(0,0,0,0.15);
    }
    h1 {
      font-size: 28px;
      font-weight: 600;
      color: #333;
      text-align: center;
      margin-bottom: 30px;
    }
    label {
      font-weight: 500;
      color: #555;
    }
    .btn-save {
      background-color: #007bff;
      color: #fff;
      border: none;
      padding: 10px 20px;
      border-radius: 8px;
      transition: 0.3s;
    }
    .btn-save:hover {
      background-color: #0056b3;
      transform: translateY(-1px);
    }
  </style>
</head>
<body>

  <div class="form-card ">
    <h1><i class="bi bi-mortarboard-fill"></i> Edit Education Details</h1>

    <form action="/employees/update_employee_education" method="post">
      <input type="hidden" name="education_id" value="<%- education.education_id %>">

      <div class="row g-4">
        <div class="col-md-6">
          <label for="college_name" class="form-label">College Name</label>
          <input type="text" class="form-control" id="college_name" name="college_name" 
                 value="<%- education.college_name %>" required>
        </div>

        <div class="col-md-6">
          <label for="course_title" class="form-label">Course Title</label>
          <input type="text" class="form-control" id="course_title" name="course_title" 
                 value="<%- education.course_title %>" required>
        </div>

        <div class="col-md-4">
          <label for="passing_year" class="form-label">Passing Year</label>
          <input type="text" class="form-control" id="passing_year" name="passing_year" 
                 value="<%- education.passing_year %>" required>
        </div>

        <div class="col-md-4">
          <label for="marks" class="form-label">Marks (%)</label>
          <input type="number" step="0.01" class="form-control" id="marks" name="marks" 
                 value="<%- education.marks %>" required>
        </div>

        <div class="col-md-4">
          <label for="status" class="form-label">Status</label>
          <select class="form-select" id="status" name="status">
            <option value="Completed" <%= education.status === 'Completed' ? 'selected' : '' %>>Completed</option>
            <option value="Appearing" <%= education.status === 'Appearing' ? 'selected' : '' %>>Appearing</option>
          </select>
        </div>
      </div>

      <div class="d-flex justify-content-end mt-4">
        <button type="submit" class="btn-save">
          <i class="bi bi-save me-1"></i> Update Education
        </button>
      </div>
    </form>
  </div>

</body>
</html>
<%-include('footer.ejs')%>