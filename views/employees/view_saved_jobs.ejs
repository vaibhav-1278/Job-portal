<%- include('navbar.ejs') %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Saved Jobs | JobHyre</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9fa;
      font-family: 'Poppins', sans-serif;
      margin-top: 20px !important;
    }
    .job-card {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      transition: transform 0.2s ease-in-out;
    }
    .job-card:hover {
      transform: translateY(-4px);
    }
    .company-logo {
      width: 80px;
      height: 80px;
      border-radius: 12px;
      object-fit: cover;
    }
    .job-title {
      font-size: 1.25rem;
      font-weight: 600;
      color: #333;
    }
    .company-name {
      color: #007bff;
      font-weight: 500;
    }
    .badge-custom {
      background: #e0f3ff;
      color: #007bff;
      border-radius: 6px;
      padding: 4px 8px;
      font-size: 0.85rem;
    }
    .skills span {
      background: #f1f3f5;
      border-radius: 8px;
      padding: 5px 10px;
      font-size: 0.8rem;
      margin: 3px;
      display: inline-block;
    }
  </style>
</head>
<body>
  <div class="container py-5">
    <h2 class="mb-4 fw-bold text-center">💼 Your Saved Jobs</h2>

    <% if(saved_jobs.length === 0) { %>
      <div class="alert alert-info text-center">You haven't saved any jobs yet.</div>
    <% } else { %>
      <div class="row g-4">
        <% saved_jobs.forEach(function(job) { %>
          <div class="col-md-6 col-lg-4">
            <div class="job-card p-4 h-100 d-flex flex-column justify-content-between">
              <div class="d-flex align-items-center mb-3">
                <img src="/company_logo/<%= job.company_logo %>" class="company-logo me-3" alt="Logo">
                <div>
                  <div class="job-title"><%= job.job_title %></div>
                  <div class="company-name"><%= job.company_name %></div>
                  <small class="text-muted"><i class="bi bi-geo-alt"></i> <%= job.company_location || 'Location not specified' %></small>
                </div>
              </div>

              <p class="text-muted mb-2"><%= job.job_description.substring(0, 80) %>...</p>

              <div class="skills mb-2">
                <% job.skills.split(' ').forEach(function(skill){ %>
                  <span><%= skill %></span>
                <% }) %>
              </div>

             <div class="d-flex justify-content-between align-items-center">
  <span class="badge-custom"><%= job.job_type %></span>

  <div>
    <!-- View Details Button -->
    <a href="/employees/job_details/<%= job.job_id %>" 
       class="btn btn-outline-primary btn-sm me-2">
      <i class="bi bi-eye"></i> View Details
    </a>

    <!-- Unsave Button -->
    <form action="/employees/unsave_job/<%= job.job_id %>" 
          method="get" 
          style="display:inline;"
          onsubmit="return confirm('Are you sure you want to remove this saved job?');">
      <button type="submit" class="btn btn-outline-danger btn-sm">
        <i class="bi bi-bookmark-x"></i> Unsave
      </button>
    </form>
  </div>
</div>

              
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<%- include('footer.ejs') %>