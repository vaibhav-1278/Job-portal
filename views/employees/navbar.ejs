<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Employee Profile</title>

<!-- Bootstrap CSS -->
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
.user-avatar {
  width: 35px; 
  height: 35px; 
  border-radius: 50%; 
  object-fit: cover; 
  border: 2px solid var(--primary);
}

.nav-link {
  margin-left: 20px;
  color: #555;
  font-weight: 500;
}
.nav-link:hover {
  color: blue;
  font-weight: 600;
}

.nav-link.active {
  color: var(--primary);
  font-weight: 600;
}

.navbar-brand i {
  color: var(--primary);
  margin-right: 5px;
}

.fixed-top {
  z-index: 9999 !important;
}
</style>
</head>
<body>

<!-- Navbar -->
<!-- Fixed Top Navbar (Employee) -->
<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm px-3 fixed-top">
  
  <!-- Logo -->
  <a class="navbar-brand d-flex align-items-center" href="#">
    <span class="ms-1 fs-3 fw-bolder text-primary text-monospace text-italic">
 Job</span><span class="text-dark fw-bold fs-3">Hyre</span>
  </a>

  <!-- Mobile Toggler -->
  <button class="navbar-toggler" type="button" data-bs-toggle="collapse" 
          data-bs-target="#employeeNavbar" aria-controls="employeeNavbar" 
          aria-expanded="false" aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
  </button>

  <!-- Menu Items -->
  <div class="collapse navbar-collapse" id="employeeNavbar">
    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

      <li class="nav-item">
        <a class="nav-link active" href="/employees">Dashboard</a>
      </li>

      <li class="nav-item">
        <a class="nav-link" href="/employees/employee_profile">My Profile</a>
      </li>

      <li class="nav-item">
        <a class="nav-link" href="/employees/all_jobs">Jobs</a>
      </li>

      <li class="nav-item">
        <a class="nav-link" href="/employees/my_applications">Applications</a>
      </li>

     

    </ul>

    <!-- Profile Dropdown -->
    <div class="d-flex align-items-center dropdown">
      <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" 
         id="employeeDropdown" data-bs-toggle="dropdown" aria-expanded="false">

        <!-- Avatar -->
        <img src="/employee_photo/<%= employee.employee_profile_photo %>" 
             alt="Avatar" class="user-avatar me-2">

        <!-- Name -->
        <span><%- employee.employee_name %></span>
      </a>

      <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="employeeDropdown">
        <li>
          <a class="dropdown-item" href="/employees/employee_profile">
            <i class="fas fa-user me-2"></i> Profile
          </a>
        </li>

        <li>
          <a class="dropdown-item" href="/employees/edit_employee_profile">
            <i class="fas fa-edit me-2"></i> Edit Profile
          </a>
        </li>

        <li><hr class="dropdown-divider"></li>

        <li>
          <a class="dropdown-item" href="/employees/employee_logout">
            <i class="fas fa-sign-out-alt me-2"></i> Logout
          </a>
        </li>
      </ul>
    </div>

  </div>
</nav>



</script>

