
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Employee Profile</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #eef2f3 0%, #d9e4ec 100%);
      padding: 30px 15px;
    }
    .form-container {
      background: #fff;
      border-radius: 15px;
      max-width: 1200px;
      margin: auto;
      box-shadow: 0 5px 25px rgba(0,0,0,0.1);
      padding: 30px;
    }
    h3 {
      font-weight: 600;
      color: #007bff;
      border-bottom: 2px solid rgba(0,123,255,0.2);
      padding-bottom: 8px;
      margin-bottom: 25px;
    }
    label {
      font-weight: 500;
      color: #2c3e50;
    }
    .btn-save {
      background: linear-gradient(135deg, #007BFF, #0056b3);
      border: none;
      color: #fff;
      padding: 10px 20px;
      border-radius: 25px;
      font-weight: 600;
      transition: 0.3s;
    }
    .btn-save:hover {
      box-shadow: 0 5px 15px rgba(0,123,255,0.4);
      transform: translateY(-2px);
    }
    .form-section {
      background: #f8f9fa;
      border-radius: 10px;
      padding: 20px;
      margin-bottom: 25px;
    }
  </style>
</head>

<body>

  <div class="form-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a href="/employees/employee_profile" class="btn btn-outline-primary"><i class="bi bi-arrow-left"></i> Back to Profile</a>
    </div>

    <form action="/employees/update_employee_profile" method="POST" enctype="multipart/form-data">
      
      <!-- Personal Info -->
      <div class="form-section">
        <h3>Personal Information</h3>
        <div class="row g-3">
          <!-- <div class="col-md-4">
            <label>Employee ID</label>
            <input type="text" class="form-control" name="employee_id" value="EMP-001" readonly>
          </div> -->
          <div class="col-md-8">
            <label>Full Name</label>
            <input type="text" class="form-control" name="employee_name" value="<%- employee.employee_name %>">
          </div>
          <div class="col-md-4">
            <label>Mobile</label>
            <input type="text" class="form-control" name="employee_mobile" value="<%- employee.employee_mobile %>">
          </div>
          <div class="col-md-4">
            <label>Alternate Mobile</label>
            <input type="text" class="form-control" name="employee_alternate_mobile" value="<%- employee.employee_alternate_mobile %>">
          </div>
          <div class="col-md-4">
            <label>Email</label>
            <input type="email" class="form-control" name="employee_email" value="<%- employee.employee_email %>">
          </div>
          <div class="col-md-4">
            <label>Date of Birth</label>
<input type="date" class="form-control" name="employee_dob" value="<%= employee.employee_dob ? employee.employee_dob.toISOString().split('T')[0] : '' %>">
          </div>
         <div class="col-md-4">
  <label>Gender</label>
  <select class="form-select" name="employee_gender">
    <option value="Male" <%= employee.employee_gender === 'Male' ? 'selected' : '' %>>Male</option>
    <option value="Female" <%= employee.employee_gender === 'Female' ? 'selected' : '' %>>Female</option>
    <option value="Other" <%= employee.employee_gender === 'Other' ? 'selected' : '' %>>Other</option>
  </select>
</div>

          <div class="col-md-4">
  <label>Marital Status</label>
  <select class="form-select" name="employee_marital_status">
    <option value="Single" <%= employee.employee_marital_status === 'Single' ? 'selected' : '' %>>Single</option>
    <option value="Married" <%= employee.employee_marital_status === 'Married' ? 'selected' : '' %>>Married</option>
  </select>
</div>

          <div class="col-md-8">
            <label>Address</label>
            <textarea class="form-control" name="employee_address" rows="2"><%- employee.employee_address %></textarea>
          </div>
          <div class="col-md-4">
            <label>Pincode</label>
            <input type="text" class="form-control" name="employee_pincode" value="<%- employee.employee_pincode %>">
          </div>
      <div class="col-md-6">
  <label>Profile Photo</label>
  <input type="file" class="form-control" name="employee_profile_photo" accept="image/*">
  <% if (employee.employee_profile_photo) { %>
    <p class="mt-1">
      Current: <a href="/uploads/<%= employee.employee_profile_photo %>" target="_blank">View Photo</a>
    </p>
  <% } %>
</div>

<div class="col-md-6">
  <label>Resume</label>
  <input type="file" class="form-control" name="employee_resume" accept=".pdf,.doc,.docx">
  <% if (employee.employee_resume) { %>
    <p class="mt-1">
      Current: <a href="/uploads/<%= employee.employee_resume %>" target="_blank">View Resume</a>
    </p>
  <% } %>
</div>

        </div>
      </div>

      <!-- Professional Info -->
      <div class="form-section">
        <h3>Professional Information</h3>
        <div class="row g-3">
          <div class="col-md-4">
            <label>Current Designation</label>
            <input type="text" class="form-control" name="employee_current_designation" value="<%- employee.employee_current_designation %>">
          </div>
          <div class="col-md-4">
            <label>Experience (Years)</label>
            <input type="number" class="form-control" name="employee_experience_years" value="<%- employee.employee_experience_years %>">
          </div>
          <div class="col-md-4">
            <label>Current Salary (₹)</label>
            <input type="text" class="form-control" name="employee_current_salary" value="<%- employee.employee_current_salary %>">
          </div>
          <div class="col-md-4">
            <label>Expected Salary (₹)</label>
            <input type="text" class="form-control" name="employee_expected_salary" value="<%- employee.employee_expected_salary %>">
          </div>
        <div class="col-md-4">
  <label>Preferred Job Type</label>
  <select class="form-select" name="employee_preferred_job_type">
    <option value="Full-Time" <%= employee.employee_preferred_job_type === 'Full-Time' ? 'selected' : '' %>>Full-Time</option>
    <option value="Part-Time" <%= employee.employee_preferred_job_type === 'Part-Time' ? 'selected' : '' %>>Part-Time</option>
    <option value="Remote" <%= employee.employee_preferred_job_type === 'Remote' ? 'selected' : '' %>>Remote</option>
  </select>
</div>

          <div class="col-md-4">
            <label>Preferred Locations</label>
            <input type="text" class="form-control" name="employee_preferred_locations" value="<%- employee.employee_preferred_locations %>">
          </div>
          <div class="col-12">
            <label>Skills Summary</label>
            <textarea class="form-control" name="employee_skills_summary" rows="2"><%- employee.employee_skills_summary %></textarea>
          </div>
          <div class="col-12">
            <label>Languages Known</label>
            <input type="text" class="form-control" name="employee_languages_known" value="<%- employee.employee_languages_known %>">
          </div>
        </div>
      </div>

      <!-- Links -->
      <div class="form-section">
        <h3>Documents & Links</h3>
        <div class="row g-3">
          <div class="col-md-4">
            <label>LinkedIn URL</label>
            <input type="url" class="form-control" name="employee_linkedin_url" value="<%- employee.employee_linkedin_url %>">
          </div>
          <div class="col-md-4">
            <label>GitHub URL</label>
            <input type="url" class="form-control" name="employee_github_url" value="<%- employee.employee_github_url %>">
          </div>
          <div class="col-md-4">
            <label>Portfolio URL</label>
            <input type="url" class="form-control" name="employee_portfolio_url" value="<%- employee.employee_portfolio_url %>">
          </div>
            <div class="d-flex justify-content-end mt-4">
        <button type="submit" class="btn-save"><i class="bi bi-save"></i> Update Profile</button>
      </div>
        </div>
      </div>
    </form>
      <!-- Education -->
       <form action="/employees/save_employee_education" method="post">
      <div class="form-section">
        <h3>Education Details</h3>
        <div class="row g-3 align-items-end">
          <div class="col-md-3">
            <label>College Name</label>
            <input type="text" class="form-control" name="college_name" value="<%- employee.college_name %>">
          </div>
          <div class="col-md-3">
            <label>Course Title</label>
            <input type="text" class="form-control" name="course_title" value="<%- employee.course_title %>">
          </div>
          <div class="col-md-2">
            <label>Passing Year</label>
            <input type="text" class="form-control" name="passing_year" value="<%- employee.passing_year %>">
          </div>
          <div class="col-md-2">
            <label>Marks (%)</label>
            <input type="text" class="form-control" name="marks" value="<%- employee.marks %>">
          </div>
          <div class="col-md-2">
  <label>Status</label>
  <select class="form-select" name="status">
    <option value="Completed" <%= employee.status === 'Completed' ? 'selected' : '' %>>Completed</option>
    <option value="Appearing" <%= employee.status === 'Appearing' ? 'selected' : '' %>>Appearing</option>
  </select>
</div>

        </div>
      </div>

      <div class="d-flex justify-content-end mt-4">
        <button type="submit" class="btn-save"><i class="bi bi-save"></i> Add Education</button>
      </div>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
