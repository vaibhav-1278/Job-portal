<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Change Password | JobHyre</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    html, body {
      height: 100%;
      margin: 0;
    }

    body {
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f4f6f9;
      font-family: 'Segoe UI', sans-serif;
      padding: 15px;
    }

    .password-card {
      width: 100%;
      max-width: 420px;
      border: none;
      border-radius: 14px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
      background: #fff;
    }

    .password-header {
      text-align: center;
      padding: 25px 20px 10px;
    }

    .password-header i {
      font-size: 48px;
      color: #4e73df; /* same as Forgot Password icon color */
    }

    .password-header h4 {
      margin-top: 10px;
      font-weight: 600;
    }

    .form-control {
      height: 48px;
      border-radius: 10px;
      font-size: 16px;
    }

    .btn-primary {
      height: 48px;
      border-radius: 10px;
      font-weight: 500;
      background: #4e73df;
      border: none;
    }

    .btn-primary:hover {
      background: #2e59d9;
    }

    .footer-link {
      font-size: 14px;
      margin-top: 10px;
    }

    /* Mobile adjustments */
    @media (max-width: 576px) {
      .password-header i {
        font-size: 38px;
      }
      .password-header h4 {
        font-size: 20px;
      }
      .form-control {
        font-size: 14px;
      }
    }
  </style>
</head>
<body>

  <div class="card password-card">
    <div class="password-header">
      <i class="bi bi-shield-lock-fill"></i>
      <h4>Change Password</h4>
      <p class="text-muted mb-0">
        Enter your new password to secure your account
      </p>
    </div>

    <div class="card-body p-4">
      <form action="/set_newcompany_password" method="POST">

        <!-- New Password -->
        <div class="mb-3">
          <label class="form-label fw-semibold">New Password</label>
          <input
            type="password"
            name="new_company_password"
            class="form-control"
            placeholder="Enter new password"
            required
          >
        </div>

        <!-- Confirm Password -->
        <div class="mb-4">
          <label class="form-label fw-semibold">Confirm Password</label>
          <input
            type="password"
            name="confirm_company_password"
            class="form-control"
            placeholder="Confirm new password"
            required
          >
        </div>

        <!-- Update Button -->
        <button type="submit" class="btn btn-primary w-100 mb-3">
          Change Password
        </button>

        <!-- Cancel -->
        <div class="text-center footer-link">
          <a href="/login" class="text-decoration-none text-danger">
            Cancel and return to login
          </a>
        </div>

      </form>
    </div>
  </div>

</body>
</html>
